# Copier ce fichier en .env puis renseigner les valeurs.

# Base PostgreSQL locale (mot de passe de l'utilisateur postgres choisi à l'installation) :
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/gestion_usine
#
# Base Supabase (Connect > Session pooler) :
# DATABASE_URL=postgresql://postgres.VOTRE_PROJET:VOTRE_MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Clé secrète Django : longue chaîne aléatoire.
# Pour en générer une : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changez-moi-avec-une-longue-chaine-aleatoire

# true en développement, false en production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# En production, l'adresse publique du site, par exemple https://gestion-usine.onrender.com
CSRF_TRUSTED_ORIGINS=

# Une pièce est en stock faible si sa quantité est inférieure ou égale à ce seuil
SEUIL_STOCK_FAIBLE=5

# Affiche l'encadré « Comptes de démonstration » sur la page de connexion
MODE_DEMO=true
