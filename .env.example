# Adresse de l'API FastAPI (sans /api à la fin).
# Sous Windows, préférer 127.0.0.1 à localhost : localhost tente d'abord l'IPv6 et ajoute ~2 s par requête.
VITE_API_URL=http://127.0.0.1:8000

# Affiche l'encadré « Comptes de démonstration » sur la page de connexion (true ou false).
VITE_MODE_DEMO=true
